{
  "id": "axon-overlay",
  "name": "Axon Overlay",
  "version": "0.2.0",
  "description": "L'île d'Axon : demandes, rappels et conversation dans la barre du système. Interface Svelte et TypeScript.",
  "kind": "desktop-overlay",
  "capacites": [
    "ile",
    "notifications"
  ],
  "frontend": "ui/index.html",
  "protocol": "axon-overlay-jsonl-v1",
  "canaux": {
    "overlay": "session CLI, un seul client",
    "controle": "messages ponctuels : rappel, basculer"
  },
  "platforms": {
    "linux-wayland": {
      "host": "gtk",
      "entrypoint": "lancer.sh",
      "toggle": "waybar-toggle.sh",
      "requirements": [
        "python3",
        "python-gobject",
        "gtk4",
        "gtk4-layer-shell",
        "webkitgtk-6.0"
      ],
      "commandes": [
        "npm",
        "/usr/bin/python3"
      ],
      "installation": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ]
    },
    "macos": {
      "host": "tauri",
      "artifact": "src-tauri/target/release/bundle/macos/Axon.app",
      "minimum": "12.0",
      "acces": "icône de la barre des menus, ⌘⇧Espace",
      "commandes": [
        "npm",
        "cargo"
      ],
      "installation": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "shell:build"
        ]
      ]
    },
    "windows": {
      "host": "tauri",
      "artifact": "src-tauri/target/release/bundle/nsis",
      "minimum": "10",
      "acces": "icône de la zone de notification, Ctrl+Maj+Espace",
      "commandes": [
        "npm",
        "cargo"
      ],
      "installation": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "shell:build"
        ]
      ]
    }
  }
}
